# Copy to .env and change the values. .env is never committed.

# Required. A long random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Coworkers type this to sign up. Leave it empty to close sign-up.
TEAM_CODE=change-me-and-share-with-your-team

# Your team's timezone. Decides what "today" is and when the order cutoff passes.
TIMEZONE=Asia/Singapore

# Set to 1 behind a proxy such as PythonAnywhere, so login rate limits see real visitor IPs.
TRUST_PROXY=0

# Session cookies are HTTPS-only by default. Browsers still accept them on http://localhost.
# Set to 0 only if you test from another device over plain HTTP.
# COOKIE_SECURE=0
